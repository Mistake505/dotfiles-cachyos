layout {

    focus-ring {
        active-color   "#f2cdcd"
        inactive-color "#1e1e2e"
        urgent-color   "#f38ba8"
    }

    border {
        active-color   "#f2cdcd"
        inactive-color "#1e1e2e"
        urgent-color   "#f38ba8"
    }

    shadow {
        color "#11111b70"
    }

    tab-indicator {
        active-color   "#f2cdcd"
        inactive-color "#df2d2d"
        urgent-color   "#f38ba8"
    }

    insert-hint {
        color "#f2cdcd80"
    }
}

recent-windows {
    highlight {
        active-color "#f2cdcd"
        urgent-color "#f38ba8"
    }
}
